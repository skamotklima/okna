# SMTP configuration for local development and runtime hosting variables.
# On Jino, set these in the Node.js application's runtime environment.
NUXT_SMTP_HOST=smtp.yandex.ru
NUXT_SMTP_PORT=465
NUXT_SMTP_SECURE=true
NUXT_SMTP_USER=user@yandex.ru
NUXT_SMTP_PASS=your_app_password
NUXT_SMTP_FROM=user@yandex.ru
NUXT_SMTP_TO=remdom.22@yandex.com

# Use sendmail only on a host with a configured local mail service.
NUXT_MAIL_TRANSPORT=smtp
NUXT_SENDMAIL_PATH=/usr/sbin/sendmail
